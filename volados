import random
import tkinter as tk
from tkinter import scrolledtext


def leer_aleatorios(texto):
    numeros = []
    for x in texto.split():
        numeros.append(float(x))
    return numeros


def simular(datos):
    filas = []
    metas = 0
    quiebras = 0
    usados = 0

    for corrida in range(1, datos["corridas"] + 1):
        dinero = datos["inicial"]
        apuesta = datos["apuesta"]
        while True:
            if apuesta > dinero:
                apuesta = dinero

            if usados < len(datos["aleatorios"]):
                r = datos["aleatorios"][usados]
            else:
                r = round(random.random(), 5)
            usados = usados + 1

            gano = r <= datos["probabilidad"]
            if gano:
                despues = dinero + apuesta
            else:
                despues = dinero - apuesta

            fila = {"corrida": corrida, "antes": dinero, "apuesta": apuesta, "r": r, "gano": gano, "despues": despues, "estado": ""}
            filas.append(fila)

            if despues >= datos["meta"]:
                fila["estado"] = "meta"
                metas = metas + 1
                break
            if despues <= 0:
                fila["estado"] = "quiebra"
                quiebras = quiebras + 1
                break

            dinero = despues
            if gano:
                apuesta = datos["apuesta"]
            else:
                apuesta = apuesta * 2

    return {"filas": filas, "metas": metas, "quiebras": quiebras, "corridas": datos["corridas"]}


