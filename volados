import os
import sys
import random
import webbrowser
from http.server import HTTPServer, BaseHTTPRequestHandler
from urllib.parse import parse_qsl


def simular(datos):
    filas = []
    metas = 0
    quiebras = 0

    for corrida in range(1, datos["corridas"] + 1):
        dinero = datos["inicial"]
        apuesta = datos["apuesta"]
        while True:
            if apuesta > dinero:
                apuesta = dinero
            r = round(random.random(), 5)
            gano = r <= datos["probabilidad"]
            if gano:
                despues = dinero + apuesta
            else:
                despues = dinero - apuesta

            fila = {"corrida": corrida, "antes": dinero, "apuesta": apuesta, "r": r, "gano": gano, "despues": despues, "estado": ""}
            filas.append(fila)

            if despues >= datos["meta"]:
                fila["estado"] = "meta"
                metas = metas + 1
                break
            if despues <= 0:
                fila["estado"] = "quiebra"
                quiebras = quiebras + 1
                break

            dinero = despues
            if gano:
                apuesta = datos["apuesta"]
            else:
                apuesta = apuesta * 2

    return {"filas": filas, "metas": metas, "quiebras": quiebras, "corridas": datos["corridas"]}


def procesar(form):
    datos = {}
    datos["inicial"] = float(form["inicial"])
    datos["meta"] = float(form["meta"])
    datos["apuesta"] = float(form["apuesta"])
    datos["probabilidad"] = float(form["probabilidad"])
    datos["corridas"] = int(form["corridas"])

    res = simular(datos)
    prob = res["metas"] / res["corridas"]

    html = open("index.html", encoding="utf-8").read().split("<form")[0]
    html += "<div class='caja'><h2>Resultados</h2>"
    html += f"<p class='optimo'>Probabilidad de llegar a la meta: {res['metas']} / {res['corridas']} = {prob:.2f}</p>"
    html += f"<p class='nota'>Veces que se llegó a la meta: {res['metas']}<br>"
    html += f"Veces que se llegó a la quiebra: {res['quiebras']}<br>"
    html += f"Corridas realizadas: {res['corridas']}</p></div>"

    html += "<div class='caja'><h2>Tabla de simulación</h2><div class='tabla'><table>"
    html += "<tr><th>Número de corrida</th><th>Cantidad antes del volado</th><th>Apuesta</th><th>Número aleatorio</th>"
    html += "<th>¿Se ganó el volado?</th><th>Cantidad después del volado</th><th>¿Se llegó a la meta?</th></tr>"
    for f in res["filas"]:
        clase = ""
        meta = "No"
        if f["estado"] == "meta":
            clase = " class='meta'"
            meta = "Sí (META)"
        if f["estado"] == "quiebra":
            clase = " class='quiebra'"
            meta = "No (QUIEBRA)"
        gano = "No"
        if f["gano"]:
            gano = "Sí"
        html += f"<tr{clase}><td>{f['corrida']}</td><td>${f['antes']:g}</td><td>${f['apuesta']:g}</td><td>{f['r']}</td>"
        html += f"<td>{gano}</td><td>${f['despues']:g}</td><td>{meta}</td></tr>"
    html += "</table></div></div>"

    html += "</main></body></html>"
    return html


class Servidor(BaseHTTPRequestHandler):

    def do_GET(self):
        self.responder(open("index.html", encoding="utf-8").read())

    def do_POST(self):
        largo = int(self.headers["Content-Length"])
        form = dict(parse_qsl(self.rfile.read(largo).decode("utf-8"), keep_blank_values=True))
        self.responder(procesar(form))

    def responder(self, html):
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()
        self.wfile.write(html.encode("utf-8"))


os.chdir(os.path.dirname(os.path.abspath(sys.argv[0])))
servidor = HTTPServer(("127.0.0.1", 0), Servidor)
webbrowser.open("http://127.0.0.1:" + str(servidor.server_port))
servidor.serve_forever()
