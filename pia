# ============================================================
#  SIMULACIÓN DE COLAS — ALMACÉN
#  Compatible con compiladores online (solo usa 'random')
#  Basado en el ejemplo del PDF (equipos 3, 4, 5, 6 personas)
# ============================================================
import random

# ---------- Distribuciones por defecto (tomadas del PDF) ----------
DIST_INICIAL = [(0, 0.50), (1, 0.25), (2, 0.15), (3, 0.10)]

DIST_LLEGADAS = [(20, 0.02), (25, 0.08), (30, 0.12), (35, 0.25), (40, 0.20),
                 (45, 0.15), (50, 0.10), (55, 0.05), (60, 0.03)]

SERVICIOS = {
    3: [(20, 0.05), (25, 0.10), (30, 0.20), (35, 0.25), (40, 0.12),
        (45, 0.10), (50, 0.08), (55, 0.06), (60, 0.04)],
    4: [(15, 0.05), (20, 0.15), (25, 0.20), (30, 0.20), (35, 0.15),
        (40, 0.12), (45, 0.08), (50, 0.04), (55, 0.01)],
    5: [(10, 0.10), (15, 0.18), (20, 0.22), (25, 0.18), (30, 0.10),
        (35, 0.08), (40, 0.06), (45, 0.05), (50, 0.03)],
    6: [(5, 0.12), (10, 0.15), (15, 0.26), (20, 0.15), (25, 0.12),
        (30, 0.08), (35, 0.06), (40, 0.04), (45, 0.02)],
}


# ============================================================
#  UTILIDADES
# ============================================================
def dist_a_texto(dist):
    return ", ".join(f"{v:g}:{p:g}" for v, p in dist)


def parse_distribucion(texto):
    res = []
    for p in texto.split(","):
        p = p.strip()
        if not p:
            continue
        if ":" not in p:
            raise ValueError(f"Formato inválido: '{p}' (use valor:prob)")
        v, prob = p.split(":", 1)
        res.append((float(v), float(prob)))
    if not res:
        raise ValueError("Distribución vacía.")
    s = sum(pr for _, pr in res)
    if abs(s - 1.0) > 1e-4:
        raise ValueError(f"Las probabilidades deben sumar 1 (suma {s:.4f}).")
    return res


def sample(r, dist):
    """Muestreo por transformada inversa (r ∈ [0,1))."""
    acum = 0.0
    for v, p in dist:
        acum += p
        if r < acum:
            return v
    return dist[-1][0]


def parse_hora(t):
    """Acepta 'HH:MM' (24 h) o 'H:MM am/pm'. Devuelve minutos desde 23:00."""
    t = t.lower().strip()
    is_pm = "pm" in t
    is_am = "am" in t
    t = t.replace("pm", "").replace("am", "").strip()
    if ":" in t:
        parts = t.split(":")
        h, m = int(parts[0]), int(parts[1]) if len(parts) > 1 else 0
    else:
        h, m = int(t), 0
    if is_pm and h != 12:
        h += 12
    if is_am and h == 12:
        h = 0
    return (h - 23) * 60 + m if h >= 23 else (h + 1) * 60 + m


def fmt_hora(mins):
    """Minutos desde 23:00 → 'H:MM am/pm'."""
    tot = int(round(mins + 23 * 60)) % (24 * 60)
    h, m = tot // 60, tot % 60
    ap = "pm" if h >= 12 else "am"
    h12 = h % 12 or 12
    return f"{h12}:{m:02d}{ap}"


# ============================================================
#  MOTOR DE SIMULACIÓN
# ============================================================
def simular(personas, semilla, d_ini, d_lleg, d_serv,
            turno_h, ap_str, lim_str, com_str, com_dur,
            sal_n, sal_e, cost_esp, cost_op):
    rng = random.Random(semilla) if semilla is not None else random.Random()

    ap = parse_hora(ap_str)
    lim = parse_hora(lim_str)
    com = parse_hora(com_str)
    turno_min = turno_h * 60
    fin_pagado = ap + turno_min + com_dur

    # --- Camiones esperando al inicio ---
    r_ini = rng.random()
    n_ini = int(sample(r_ini, d_ini))

    # --- Llegadas hasta la hora límite ---
    llegadas = [(ap, None, None, False) for _ in range(n_ini)]
    t = ap
    while True:
        r = rng.random()
        dt = sample(r, d_lleg)
        tn = t + dt
        if tn > lim:
            llegadas.append((tn, r, dt, True))
            break
        llegadas.append((tn, r, dt, False))
        t = tn

    # --- Simulación secuencial ---
    times = []
    fin_prev = ap
    comida_tomada = False
    com_real_ini = com_real_fin = None

    for (tl, r_dt, dt, rech) in llegadas:
        if rech:
            times.append(dict(rechazado=True, tl=tl, r_dt=r_dt, dt=dt,
                              t_inicio=None, t_fin=None, espera=0, ocio=0))
            continue

        candidato = max(tl, fin_prev)

        # --- Regla de la comida ---
        if not comida_tomada:
            if fin_prev >= com:            # llega la hora y aún trabajaba
                com_real_ini = fin_prev
                com_real_fin = com_real_ini + com_dur
                comida_tomada = True
                candidato = max(tl, com_real_fin)
            elif candidato >= com:         # terminaría después de las 3:00
                com_real_ini = com
                com_real_fin = com + com_dur
                comida_tomada = True
                candidato = max(tl, com_real_fin)

        t_inicio = candidato
        ocio = t_inicio - fin_prev
        if (com_real_ini is not None
                and com_real_ini >= fin_prev
                and com_real_fin <= t_inicio):
            ocio -= com_dur
        ocio = max(0, ocio)

        r_s = rng.random()
        serv = sample(r_s, d_serv)
        t_fin = t_inicio + serv
        espera = t_inicio - tl

        times.append(dict(rechazado=False, tl=tl, t_inicio=t_inicio, t_fin=t_fin,
                          espera=espera, ocio=ocio, r_dt=r_dt, dt=dt,
                          r_s=r_s, serv=serv))
        fin_prev = t_fin

    # --- Longitud de cola al llegar (camiones esperando) ---
    for i, info in enumerate(times):
        info["cola"] = sum(
            1 for j in range(i)
            if not times[j]["rechazado"]
            and times[j]["tl"] <= info["tl"]
            and times[j]["t_inicio"] > info["tl"]
        )

    # --- Totales ---
    servidos = [x for x in times if not x["rechazado"]]
    espera_total = sum(x["espera"] for x in servidos)
    ocio_durante = sum(x["ocio"] for x in servidos)
    ultimo_fin = max(x["t_fin"] for x in servidos) if servidos else ap
    ocio_final = max(0, lim - ultimo_fin) if ultimo_fin < lim else 0
    overtime_h = max(0, ultimo_fin - fin_pagado) / 60

    sal_normal = personas * turno_h * sal_n
    sal_extra = personas * overtime_h * sal_e
    costo_espera = (espera_total / 60) * cost_esp
    costo_op = (turno_h + overtime_h) * cost_op

    return dict(
        filas=times,
        n_inicial=n_ini, r_ini=r_ini,
        camiones_atendidos=len(servidos),
        comida_ini=com_real_ini, comida_fin=com_real_fin,
        ultimo_fin=ultimo_fin, overtime_h=overtime_h,
        ocio_durante=ocio_durante, ocio_final=ocio_final,
        ocio_total=ocio_durante + ocio_final,
        espera_total_min=espera_total, espera_total_h=espera_total / 60,
        sal_normal=sal_normal, sal_extra=sal_extra,
        costo_espera=costo_espera, costo_operacion=costo_op,
        costo_total=sal_normal + sal_extra + costo_espera + costo_op,
    )


# ============================================================
#  IMPRESIÓN
# ============================================================
def imprimir_tabla(filas):
    encabezados = ["R_lleg", "T_lleg", "Llegada", "Inicio",
                   "R_serv", "T_serv", "Fin", "Ocio", "Espera", "Cola"]
    anchos = [8, 6, 9, 9, 8, 6, 9, 6, 7, 6]
    print("  " + " ".join(h.center(a) for h, a in zip(encabezados, anchos)))
    print("  " + "-" * (sum(anchos) + len(anchos) - 1))
    for info in filas:
        if info["rechazado"]:
            r_dt = f"{info['r_dt']:.5f}" if info["r_dt"] is not None else "—"
            dt = str(info["dt"]) if info["dt"] is not None else "—"
            vals = [r_dt, dt, fmt_hora(info["tl"]), "No recibe",
                    "—", "—", "—", "—", "—", str(info["cola"])]
        else:
            r_dt = "—" if info["r_dt"] is None else f"{info['r_dt']:.5f}"
            dt = "—" if info["dt"] is None else str(info["dt"])
            vals = [r_dt, dt, fmt_hora(info["tl"]), fmt_hora(info["t_inicio"]),
                    f"{info['r_s']:.5f}", str(info["serv"]),
                    fmt_hora(info["t_fin"]), str(info["ocio"]),
                    str(info["espera"]), str(info["cola"])]
        print("  " + " ".join(v.center(a) for v, a in zip(vals, anchos)))


def imprimir_resultado(n, res):
    print("\n" + "=" * 72)
    print(f"  EQUIPO DE {n} PERSONAS")
    print("=" * 72)
    print(f"  Camiones iniciales : {res['n_inicial']}   (R_inicial = {res['r_ini']:.5f})")
    print(f"  Camiones atendidos : {res['camiones_atendidos']}")
    com_i = fmt_hora(res["comida_ini"]) if res["comida_ini"] is not None else "—"
    com_f = fmt_hora(res["comida_fin"]) if res["comida_fin"] is not None else "—"
    print(f"  Comida personal    : {com_i} – {com_f}")
    print(f"  Última descarga    : {fmt_hora(res['ultimo_fin'])}  ({res['overtime_h']:.4f} h extra)")
    print(f"  Ocio del personal  : {res['ocio_durante']:.2f} min + "
          f"{res['ocio_final']:.2f} min = {res['ocio_total']:.2f} min")
    print(f"  Espera camiones    : {res['espera_total_min']:.2f} min "
          f"({res['espera_total_h']:.4f} h)")
    print()
    imprimir_tabla(res["filas"])

    print("\n  COSTOS:")
    print(f"    Salario normal          : ${res['sal_normal']:>10.2f}")
    print(f"    Salario extra           : ${res['sal_extra']:>10.2f}")
    print(f"    Costo espera camiones   : ${res['costo_espera']:>10.2f}")
    print(f"    Costo operación almacén : ${res['costo_operacion']:>10.2f}")
    print(f"    {'-'*40}")
    print(f"    COSTO TOTAL             : ${res['costo_total']:>10.2f}")


def imprimir_comparacion(resultados):
    print("\n" + "=" * 72)
    print("  COMPARACIÓN DE COSTOS POR EQUIPO")
    print("=" * 72)
    print(f"  {'Equipo':<12}{'Sal.Normal':>11}{'Sal.Extra':>11}"
          f"{'Espera':>11}{'Operac.':>11}{'TOTAL':>12}")
    print("  " + "-" * 68)
    mejor = None
    for n, r in resultados.items():
        print(f"  {str(n)+' personas':<12}"
              f"{'$'+format(r['sal_normal'], '.2f'):>11}"
              f"{'$'+format(r['sal_extra'], '.2f'):>11}"
              f"{'$'+format(r['costo_espera'], '.2f'):>11}"
              f"{'$'+format(r['costo_operacion'], '.2f'):>11}"
              f"{'$'+format(r['costo_total'], '.2f'):>12}")
        if mejor is None or r["costo_total"] < mejor[1]["costo_total"]:
            mejor = (n, r)
    print("  " + "-" * 68)
    if mejor:
        print(f"  ► EQUIPO ÓPTIMO: {mejor[0]} personas  →  "
              f"costo total ${mejor[1]['costo_total']:.2f}")


# ============================================================
#  ENTRADA DE DATOS
# ============================================================
def pedir(msg, defecto, cast=str):
    try:
        s = input(f"  {msg} [{defecto}]: ").strip()
    except EOFError:
        s = ""
    if not s:
        s = str(defecto)
    return cast(s) if cast != str else s


def main():
    print("=" * 72)
    print("  SIMULACIÓN DE COLAS — ALMACÉN")
    print("=" * 72)
    print("  Presiona ENTER para aceptar el valor por defecto [entre corchetes].\n")

    # --- Equipos a comparar ---
    equipos_txt = pedir("Equipos a comparar (separados por coma)", "3,4,5,6")
    equipos = []
    for x in equipos_txt.split(","):
        x = x.strip()
        if x:
            try:
                equipos.append(int(x))
            except ValueError:
                pass
    if not equipos:
        equipos = [3, 4, 5, 6]

    # --- Semilla ---
    try:
        semilla_txt = input("  Semilla aleatoria (Enter = aleatoria): ").strip()
    except EOFError:
        semilla_txt = ""
    semilla = int(semilla_txt) if semilla_txt else None

    # --- Distribuciones ---
    dist_ini_txt = pedir("Distribución camiones iniciales",
                         dist_a_texto(DIST_INICIAL))
    dist_lleg_txt = pedir("Distribución tiempo entre llegadas (min)",
                          dist_a_texto(DIST_LLEGADAS))

    # --- Horarios ---
    print()
    turno_h = pedir("Turno (horas normales)", 8, float)
    apertura = pedir("Hora apertura (HH:MM o H:MM am/pm)", "23:00")
    limite = pedir("Hora límite de recepción", "07:30")
    comida = pedir("Hora inicio comida", "03:00")
    comida_dur = pedir("Duración comida (min)", 30, float)

    # --- Costos ---
    print()
    sal_n = pedir("Salario normal ($/h por persona)", 25, float)
    sal_e = pedir("Salario extra ($/h por persona)", 37.5, float)
    cost_esp = pedir("Costo espera camiones ($/h)", 100, float)
    cost_op = pedir("Costo operación almacén ($/h)", 500, float)

    # --- Parseo de distribuciones comunes ---
    try:
        d_ini = parse_distribucion(dist_ini_txt)
        d_lleg = parse_distribucion(dist_lleg_txt)
    except ValueError as e:
        print(f"\n  ERROR en distribuciones: {e}")
        return

    # --- Simulación por equipo ---
    resultados = {}
    for n in equipos:
        if n in SERVICIOS:
            d_serv = SERVICIOS[n]
        else:
            print(f"\n  El equipo de {n} personas no tiene default en el PDF.")
            t = pedir(f"    Distribución de servicio para {n} personas",
                      "30:0.20, 35:0.60, 40:0.20")
            try:
                d_serv = parse_distribucion(t)
            except ValueError as e:
                print(f"    Error: {e}. Se omite.")
                continue

        res = simular(n, semilla, d_ini, d_lleg, d_serv,
                      turno_h, apertura, limite, comida, comida_dur,
                      sal_n, sal_e, cost_esp, cost_op)
        resultados[n] = res
        imprimir_resultado(n, res)

    # --- Comparación final ---
    if resultados:
        imprimir_comparacion(resultados)
        print("\n  (Los resultados son aproximados: el valor exacto depende")
        print("   de la semilla. Vuelve a correr con otra semilla para verificar.)")


# ============================================================
if __name__ == "__main__":
    main()
