import random

def dist_rand(n, lo, hi):
    ops = list(range(lo, hi + 1))
    if len(ops) < n:
        n = len(ops)
    vals = sorted(random.sample(ops, n))
    ws = [random.random() + 0.1 for _ in vals]
    t = sum(ws)
    return [(v, w / t) for v, w in zip(vals, ws)]

def dist_leer(txt, n, lo, hi):
    if not txt.strip():
        return dist_rand(n, lo, hi)
    out = []
    for p in txt.split(","):
        p = p.strip()
        if p:
            v, pr = p.split(":")
            out.append((float(v), float(pr)))
    t = sum(pr for _, pr in out)
    return [(v, pr / t) for v, pr in out]

def pick(r, d):
    acc = 0.0
    for v, p in d:
        acc += p
        if r <= acc:
            return v
    return d[-1][0]

def a_min(t):
    t = t.strip().lower().replace(".", "").replace(" ", "")
    pm = "pm" in t
    am = "am" in t
    t = t.replace("pm", "").replace("am", "")
    if ":" in t:
        a, b = t.split(":")[:2]
        h, m = int(a), int(b)
    else:
        h, m = int(t), 0
    if pm and h != 12:
        h += 12
    if am and h == 12:
        h = 0
    return h * 60 + m

def a_hora(m):
    m = int(round(m)) % 1440
    h, mm = m // 60, m % 60
    suf = "pm" if h >= 12 else "am"
    h = h % 12 or 12
    return "%d:%02d%s" % (h, mm, suf)

def simular(np, seed, di, dl, ds, ht, ha, hl, hc, mc, pn, pe, ce, co):
    if seed is None:
        random.seed()
    else:
        random.seed(seed)

    ap = a_min(ha)
    lim = a_min(hl)
    com = a_min(hc)
    tmin = ht * 60
    fin_pago = ap + tmin + mc

    r0 = random.random()
    n_ini = int(pick(r0, di))

    arr = [(ap, None, None, False) for _ in range(n_ini)]
    t = ap
    while True:
        r = random.random()
        dt = pick(r, dl)
        tn = t + dt
        if tn > lim:
            arr.append((tn, r, dt, True))
            break
        arr.append((tn, r, dt, False))
        t = tn

    filas = []
    fin_prev = ap
    hecho = False
    ci = cf = None

    for (tl, rd, dt, rech) in arr:
        if rech:
            filas.append({"rech": 1, "tl": tl, "rd": rd, "dt": dt,
                          "ini": None, "fin": None, "esp": 0, "oc": 0,
                          "rs": None, "serv": None})
            continue
        cand = max(tl, fin_prev)
        if not hecho:
            if fin_prev >= com:
                ci = fin_prev
                cf = ci + mc
                hecho = True
                cand = max(tl, cf)
            elif cand >= com:
                ci = com
                cf = com + mc
                hecho = True
                cand = max(tl, cf)
        ini = cand
        oc = ini - fin_prev
        if ci is not None and ci >= fin_prev and cf <= ini:
            oc -= mc
        if oc < 0:
            oc = 0
        rs = random.random()
        serv = pick(rs, ds)
        fin = ini + serv
        esp = ini - tl
        filas.append({"rech": 0, "tl": tl, "ini": ini, "fin": fin,
                      "esp": esp, "oc": oc, "rd": rd, "dt": dt,
                      "rs": rs, "serv": serv})
        fin_prev = fin

    for i, f in enumerate(filas):
        c = 0
        for j in range(i):
            if not filas[j]["rech"] and filas[j]["tl"] <= f["tl"] and filas[j]["ini"] > f["tl"]:
                c += 1
        f["cola"] = c

    ok = [f for f in filas if not f["rech"]]
    esp_tot = sum(f["esp"] for f in ok)
    oc_turno = sum(f["oc"] for f in ok)
    ult = max(f["fin"] for f in ok) if ok else ap
    oc_fin = max(0, lim - ult) if ult < lim else 0
    extra = max(0, ult - fin_pago) / 60

    sn = np * ht * pn
    se = np * extra * pe
    ces = esp_tot / 60 * ce
    cop = (ht + extra) * co
    return {"filas": filas, "n_ini": n_ini, "ok": len(ok),
            "ci": ci, "cf": cf, "ult": ult, "extra": extra,
            "oc_turno": oc_turno, "oc_fin": oc_fin,
            "oc_tot": oc_turno + oc_fin,
            "esp_min": esp_tot, "esp_h": esp_tot / 60,
            "sn": sn, "se": se, "ces": ces, "cop": cop,
            "tot": sn + se + ces + cop}

def mostrar(n, r):
    print("\n--- Equipo de %d personas ---" % n)
    print("Camiones al inicio: %d" % r["n_ini"])
    print("Atendidos: %d" % r["ok"])
    if r["ci"] is not None:
        print("Comida: %s a %s" % (a_hora(r["ci"]), a_hora(r["cf"])))
    print("Ultima descarga: %s" % a_hora(r["ult"]))
    if r["extra"] > 0:
        print("Tiempo extra: %.2f h" % r["extra"])
    print("Ocio del personal: %.1f min" % r["oc_tot"])
    print("Espera de camiones: %.1f min" % r["esp_min"])
    print()
    print("  llegada   inicio    fin  serv  ocio  espera  cola")
    for f in r["filas"]:
        if f["rech"]:
            print("  %-8s  RECHAZADO" % a_hora(f["tl"]))
        else:
            print("  %-8s  %-8s  %-8s %3s %5s %7s %5s" % (
                a_hora(f["tl"]), a_hora(f["ini"]), a_hora(f["fin"]),
                f["serv"], f["oc"], f["esp"], f["cola"]))
    print()
    print("Costos:")
    print("  normal     %.2f" % r["sn"])
    print("  extra      %.2f" % r["se"])
    print("  espera     %.2f" % r["ces"])
    print("  operacion  %.2f" % r["cop"])
    print("  TOTAL      %.2f" % r["tot"])

def pedir(msg, gen):
    s = input(msg).strip()
    return s if s else gen()

def main():
    print("Simulacion de colas - almacen")
    print("Enter en cualquier campo = valor aleatorio\n")

    eqs = input("Equipos a comparar (ej 3,4,5): ").strip()
    if eqs:
        equipos = [int(x) for x in eqs.split(",") if x.strip()]
    else:
        k = random.randint(2, 4)
        equipos = sorted(random.sample(range(2, 8), k))
        print("  -> %s" % equipos)

    sem = input("Semilla (Enter = aleatoria): ").strip()
    semilla = int(sem) if sem else None

    print("\nDistribuciones (vacio = aleatoria)")
    di_t = input("  camiones iniciales: ").strip()
    dl_t = input("  tiempo entre llegadas: ").strip()

    print("\nHorarios")
    ht = float(pedir("  horas de turno [%d]: " % random.randint(6, 10),
                     lambda: str(random.randint(6, 10))))
    ha = pedir("  apertura [%d:00]: " % random.randint(20, 23),
               lambda: "%d:00" % random.randint(20, 23))
    hl = pedir("  limite [%d:00]: " % random.randint(5, 9),
               lambda: "%d:00" % random.randint(5, 9))
    hc = pedir("  comida inicio [%d:00]: " % random.randint(0, 4),
               lambda: "%d:00" % random.randint(0, 4))
    mc = float(pedir("  duracion comida [%d]: " % random.randint(20, 45),
                     lambda: str(random.randint(20, 45))))

    print("\nCostos")
    pn = float(pedir("  pago normal [%d]: " % random.randint(20, 40),
                     lambda: str(random.randint(20, 40))))
    pe = float(pedir("  pago extra [%d]: " % random.randint(30, 60),
                     lambda: str(random.randint(30, 60))))
    ce = float(pedir("  costo espera [%d]: " % random.randint(50, 200),
                     lambda: str(random.randint(50, 200))))
    co = float(pedir("  costo operacion [%d]: " % random.randint(200, 800),
                     lambda: str(random.randint(200, 800))))

    di = dist_leer(di_t, random.randint(2, 4), 0, 5)
    dl = dist_leer(dl_t, random.randint(3, 6), 15, 70)

    print()
    res = {}
    for n in equipos:
        lo = max(3, 22 - 3 * (n - 3))
        hi = max(lo + 20, 65 - 4 * (n - 3))
        ds = dist_rand(random.randint(3, 6), lo, hi)
        r = simular(n, semilla, di, dl, ds, ht, ha, hl, hc, mc,
                    pn, pe, ce, co)
        res[n] = r
        mostrar(n, r)

    print("\n--- Comparacion ---")
    for n in sorted(res):
        print("  %d personas: %.2f" % (n, res[n]["tot"]))
    mejor = min(res, key=lambda k: res[k]["tot"])
    print("\nMejor equipo: %d personas (%.2f)" % (mejor, res[mejor]["tot"]))

if __name__ == "__main__":
    main()
